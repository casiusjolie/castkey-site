# Submission mode: "demo" (default) validates and shows "Demo only: your application was not sent".
# "endpoint" posts to VITE_FORM_ENDPOINT (the Google Apps Script web app URL, see README) and shows success only after the sheet confirms the row was saved.
# Leave as demo until an approved destination, storage/retention approach and privacy notice exist.
VITE_SUBMISSION_MODE=demo
VITE_FORM_ENDPOINT=
# Links shown in the footer and forms once approved documents exist. Leave blank to show "pending".
VITE_PRIVACY_URL=
VITE_TERMS_URL=
# Canonical URL for metadata. Leave blank until the production domain is decided.
VITE_CANONICAL_URL=
# Public site URL, e.g. https://castkey.com. Used for invite links (/invite/, /invited/#invite-CODE)
# and for the absolute share-thumbnail URLs social apps require. Set this before launch.
VITE_SITE_URL=
# Identity verification: 'preview' (default, nothing is checked) or 'provider' once a provider SDK is wired in src/lib/verify.ts.
VITE_VERIFY_MODE=preview
