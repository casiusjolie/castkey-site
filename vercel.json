{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/app/"
    },
    {
      "source": "/r/:code",
      "destination": "/invited/"
    },
    {
      "source": "/(apply|join|creators|brands|demo|agencies|partners|refer|calls|earn|how|faq|standard)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/investors/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}